{
 "description": "Manifest vectors. Each entry is a manifest and either no 'error' (it must be accepted) or the error code every implementation must report.",
 "vectors": [
  {
   "name": "minimal",
   "manifest": {
    "protocol": "fogping-probe/1",
    "type": "dns",
    "label": "DNS",
    "uses_port": false,
    "options": []
   }
  },
  {
   "name": "all kinds",
   "manifest": {
    "protocol": "fogping-probe/1",
    "type": "dns",
    "label": "DNS",
    "uses_port": false,
    "options": [
     {
      "key": "record",
      "label": "Record",
      "kind": "choice",
      "choices": [
       "A",
       "MX"
      ],
      "default": "A"
     },
     {
      "key": "retries",
      "label": "Retries",
      "kind": "int",
      "min": 0,
      "max": 5,
      "default": 1
     },
     {
      "key": "query",
      "label": "Query",
      "kind": "string",
      "required": true,
      "max_len": 64
     },
     {
      "key": "use_tcp",
      "label": "Use_Tcp",
      "kind": "bool"
     }
    ]
   }
  },
  {
   "name": "uses_port",
